<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background_gradient">

    <LinearLayout
        android:id="@+id/layoutDetailRoot"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="120dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 민원 기본 정보 카드 -->
        <LinearLayout
            android:id="@+id/layoutDetailCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/card_background"
            android:layout_marginBottom="12dp">

            <!-- 첫 줄: 장소 + 상태 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textDetailLocation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="장소"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/textDetailStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="진행중"
                    android:textColor="@android:color/holo_orange_light"
                    android:textStyle="bold"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 둘째 줄: 등록일시 / 완료일시 -->
            <TextView
                android:id="@+id/textDetailCreatedAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="등록일시: -"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/textDetailDoneAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="완료일시: -"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <!-- 셋째 줄: 상세 내용 -->
            <TextView
                android:id="@+id/textDetailDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="상세 내용..."
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- 댓글 헤더 -->
        <TextView
            android:id="@+id/textDetailCommentCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="댓글 0개"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <!-- 댓글 목록 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewComments"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
